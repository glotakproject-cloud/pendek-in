# ==============================================================================
# PENDEK-IN: TEMPLATE VARIABEL ENVIRONMENT PRODUKSI (.env.production)
# Salin file ini menjadi .env.production di server Anda atau isi di Dashboard Vercel
# ==============================================================================

# 1. Konfigurasi Domain Aplikasi
NEXT_PUBLIC_APP_URL=https://pendek.in
NEXT_PUBLIC_APP_NAME=Pendek-In

# 2. Supabase Backend (Auth, Database, Storage)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# 3. Kriptografi & Privasi (Wajib diisi dengan string acak aman minimal 32 karakter)
# Digunakan untuk hashing alamat IP pengunjung secara irreversibel (SHA-256)
IP_HASH_SALT=your_super_secret_ip_salt_random_string_min_32_chars_2026

# 4. Layanan Pengiriman Email (Resend)
# Dapatkan API Key dari https://resend.com/api-keys
RESEND_API_KEY=re_your_production_resend_api_key
EMAIL_FROM=Pendek-In <notifications@pendek.in>

# 5. Rate Limiting Terdistribusi (Upstash Redis)
# Dapatkan dari https://console.upstash.com -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_production_upstash_rest_token

# 6. Keamanan Panggilan Cron (Supabase Edge Function)
CRON_SECRET=your_super_secret_cron_bearer_token_string_here
